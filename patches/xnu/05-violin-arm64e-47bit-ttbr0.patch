+#endif
 #endif /* defined(__arm64__) && MACH_ASSERT && !__BUILDING_XNU_LIBRARY__ */
 		const uint64_t max_va_bits = 48;
 		const mach_vm_offset_t va_range_upper_bound = (1ULL << max_va_bits);
