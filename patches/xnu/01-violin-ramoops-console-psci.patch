diff -ruN a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
--- a/pexpert/arm/pe_serial.c	2026-11-24 18:14:59.111286778 +0800
+++ b/pexpert/arm/pe_serial.c	2026-11-24 18:14:59.239434180 +0800
@@ -738,6 +738,162 @@
  *
  * @param str The string to output.
  */
+
+/*****************************************************************************/
+/* Violin Stage-3 persistent dual-ring ramoops console + PSCI reset/off      */
+/*****************************************************************************/
+
+#define VIOLIN_RAMOOPS_CONSOLE_PA   0xA0040000ULL
+#define VIOLIN_RAMOOPS_CONSOLE_SZ   0x00080000ULL
+#define VIOLIN_RAMOOPS_PMSG_PA      0xA00C0000ULL
+#define VIOLIN_RAMOOPS_PMSG_SZ      0x00040000ULL
+#define VIOLIN_RAMOOPS_SIG          0x43474244U
+#define VIOLIN_QEMU_PL011_PA        0x09000000ULL
+#define VIOLIN_QEMU_PL011_SZ        0x00001000ULL
+
+struct violin_ramoops_hdr {
+	uint32_t sig;
+	uint32_t start;
+	uint32_t size;
+};
+
+static vm_offset_t violin_console_va = 0;
+static vm_offset_t violin_pmsg_va = 0;
+static vm_offset_t violin_pl011_va = 0;
+static uint32_t violin_ramoops_active = 0;
+static uint32_t violin_qemu_mode = 0;
+
+static void
+violin_ramoops_ring_putc(vm_offset_t base, uint32_t total_size, uint8_t c)
+{
+	if (base == 0 || total_size <= sizeof(struct violin_ramoops_hdr)) {
+		return;
+	}
+	volatile struct violin_ramoops_hdr *hdr = (volatile struct violin_ramoops_hdr *)base;
+	if (hdr->sig != VIOLIN_RAMOOPS_SIG) {
+		return;
+	}
+	uint32_t cap = total_size - (uint32_t)sizeof(struct violin_ramoops_hdr);
+	uint32_t start = hdr->start;
+	uint32_t size = hdr->size;
+	if (start >= cap || size > cap) {
+		return;
+	}
+	volatile uint8_t *data = (volatile uint8_t *)(base + sizeof(struct violin_ramoops_hdr));
+	data[start] = c;
+	start = (start + 1U >= cap) ? 0U : (start + 1U);
+	if (size < cap) {
+		size++;
+	}
+	__builtin_arm_dmb(DMB_ISHST);
+	hdr->start = start;
+	hdr->size = size;
+	if (c == '\n') {
+		__builtin_arm_dsb(DSB_SY);
+	}
+}
+
+static void
+violin_ramoops_transmit_data(uint8_t c)
+{
+	violin_ramoops_ring_putc(violin_console_va, (uint32_t)VIOLIN_RAMOOPS_CONSOLE_SZ, c);
+	violin_ramoops_ring_putc(violin_pmsg_va, (uint32_t)VIOLIN_RAMOOPS_PMSG_SZ, c);
+	if (violin_pl011_va != 0) {
+		volatile uint32_t *fr = (volatile uint32_t *)(violin_pl011_va + 0x18U);
+		volatile uint32_t *dr = (volatile uint32_t *)(violin_pl011_va + 0x00U);
+		for (unsigned int spin = 0; spin < 100000U; spin++) {
+			if ((*fr & (1U << 5)) == 0U) {
+				break;
+			}
+		}
+		*dr = (uint32_t)c;
+	}
+}
+
+static void
+violin_ramoops_puts(const char *s)
+{
+	if (s == NULL) {
+		return;
+	}
+	while (*s != '\0') {
+		violin_ramoops_transmit_data((uint8_t)(*s++));
+	}
+	__builtin_arm_dsb(DSB_SY);
+}
+
+static void
+violin_ramoops_init(void)
+{
+}
+
+static unsigned int
+violin_ramoops_transmit_ready(void)
+{
+	return 1U;
+}
+
+static unsigned int
+violin_ramoops_receive_ready(void)
+{
+	return 0U;
+}
+
+static uint8_t
+violin_ramoops_receive_data(void)
+{
+	return 0U;
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) violin_ramoops_serial_functions =
+{
+	.init = violin_ramoops_init,
+	.transmit_ready = violin_ramoops_transmit_ready,
+	.transmit_data = violin_ramoops_transmit_data,
+	.receive_ready = violin_ramoops_receive_ready,
+	.receive_data = violin_ramoops_receive_data,
+	.has_irq = false,
+	.device = SERIAL_UNKNOWN
+};
+
+void violin_psci_reset_or_off(uint32_t delay_sec, const char *reason);
+
+void
+violin_psci_reset_or_off(uint32_t delay_sec, const char *reason)
+{
+	if (!violin_ramoops_active) {
+		return;
+	}
+	violin_ramoops_puts("\n[XNU_VIOLIN_EXIT] reason=");
+	violin_ramoops_puts(reason ? reason : "unknown");
+	violin_ramoops_puts(violin_qemu_mode ? " action=PSCI_SYSTEM_OFF(hvc)\n" : " action=PSCI_SYSTEM_RESET(smc)\n");
+	__builtin_arm_dsb(DSB_SY);
+
+	if (delay_sec > 0U && !violin_qemu_mode) {
+		uint64_t freq = 0, t0 = 0, now = 0;
+		__asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (freq));
+		__asm__ volatile ("isb\n\tmrs %0, cntpct_el0" : "=r" (t0));
+		if (freq == 0ULL) {
+			freq = 38400000ULL;
+		}
+		uint64_t wait_ticks = (uint64_t)delay_sec * freq;
+		do {
+			__asm__ volatile ("yield\n\tmrs %0, cntpct_el0" : "=r" (now));
+		} while ((now - t0) < wait_ticks);
+	}
+
+	__asm__ volatile ("msr daifset, #15\n\tdsb sy\n\tisb" ::: "memory");
+	register uint64_t x0 __asm__("x0") = violin_qemu_mode ? 0x84000008ULL : 0x84000009ULL;
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	if (violin_qemu_mode) {
+		__asm__ volatile ("hvc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) :: "memory");
+	} else {
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) :: "memory");
+	}
+}
