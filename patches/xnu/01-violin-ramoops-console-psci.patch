@@ -841,6 +853,64 @@
 	// Branch to the trampoline
 	br		x0
 
+	/*
+	 * Violin Stage-3 pre-MMU dual-ring ramoops logger (PA, MMU off).
+	 * Input: x9 = C string PA. Preserves x17, x19-x28, sp.
+	 * Appends only if header magic == "DBGC" (0x43474244).
+	 */
+	.align 2
+Lviolin_early_pa_log_dual:
+	mov		x16, lr
+	movz	x10, #0xA004, lsl #16		// console-ramoops-0 @ 0xA0040000
+	movz	w11, #0xFFF4
+	movk	w11, #0x0007, lsl #16		// cap = 0x80000 - 12 = 0x7FFF4
+	bl		Lviolin_early_pa_log_ring
+	movz	x10, #0xA00C, lsl #16		// pmsg-ramoops-0 @ 0xA00C0000
+	movz	w11, #0xFFF4
+	movk	w11, #0x0003, lsl #16		// cap = 0x40000 - 12 = 0x3FFF4
+	bl		Lviolin_early_pa_log_ring
+	mov		lr, x16
+	ret
+
+	.align 2
+Lviolin_early_pa_log_ring:
+	ldr		w12, [x10, #0]
+	movz	w13, #0x4244
+	movk	w13, #0x4347, lsl #16		// "DBGC"
+	cmp		w12, w13
+	b.ne	3f
+	ldr		w12, [x10, #4]			// start
+	ldr		w13, [x10, #8]			// size
+	cmp		w12, w11
+	b.hs	3f
+	cmp		w13, w11
+	b.hi	3f
+	mov		x14, x9
+	add		x15, x10, #12
+1:
+	ldrb	w0, [x14], #1
+	cbz		w0, 2f
+	strb	w0, [x15, w12, uxtw]
+	add		w12, w12, #1
+	cmp		w12, w11
+	csel	w12, wzr, w12, hs
+	cmp		w13, w11
+	cinc	w13, w13, lo
+	b		1b
+2:
+	dmb		sy
+	str		w12, [x10, #4]
+	str		w13, [x10, #8]
+	dsb		sy
+3:
+	ret
+
+Lviolin_msg_entry:
+	.asciz	"[XNU_EARLY] start_first_cpu (PA)\n"
+Lviolin_msg_mmu:
+	.asciz	"[XNU_EARLY] PAC keys loaded; enabling MMU+PAC\n"
+	.align 2
