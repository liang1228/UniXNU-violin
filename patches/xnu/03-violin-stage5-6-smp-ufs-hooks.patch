+static void
+violin_stage5_watchdog_thread(void *arg, __unused wait_result_t wr)
+{
+	uint32_t sec = (uint32_t)(uintptr_t)arg;
+	if (sec == 0U || sec > 60U) {
+		sec = 15U;
+	}
+	IOSleep(sec * 1000U);
+	extern void violin_psci_reset_or_off(uint32_t delay_sec, const char *reason);
+	extern volatile uint32_t armcpu_smp_running;
+	extern volatile uint32_t armcpu_core_timer[8];
+	extern volatile uint32_t armcpu_core_sgi[8];
+	kprintf("[XNU_STAGE5_WATCHDOG] TIMEOUT after %us (smp_running=%u timer0=%u sgi0=%u)\n",
+	    sec, armcpu_smp_running, armcpu_core_timer[0], armcpu_core_sgi[0]);
+	violin_psci_reset_or_off(1U, "stage5-watchdog");
+	thread_terminate(current_thread());
+}
